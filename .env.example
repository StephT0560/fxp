# Copy to .env, then replace blanks with independently generated values.
# openssl rand -hex 32 for JWT and core token; use a different value for each.
FXP_JWT_SECRET=
FXP_CORE_AUTH_TOKEN=
# e.g. FIRM01:<output of openssl rand -hex 24>
FXP_FIX_CREDENTIALS=
# Host group owning certs/; set to the output of id -g after make dev-certs.
FXP_CERT_GID=1000
FXP_CERTS_DIR=./certs
# Secure Compose uses TLS + client certificates by default.
# Container paths, not host paths:
FXP_TLS_CERT_FILE=/etc/fxp/certs/server.crt
FXP_TLS_KEY_FILE=/etc/fxp/certs/server.key
FXP_TLS_CLIENT_CA_FILE=/etc/fxp/certs/ca.crt
